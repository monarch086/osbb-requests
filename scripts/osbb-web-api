#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$project_root/scripts/osbb-data-env.sh"
cd "$project_root"
import_database="${OSBB_IMPORT_DATABASE:?Set OSBB_IMPORT_DATABASE}"
web_database="${OSBB_DATABASE:?Set OSBB_DATABASE}"
database_user="${OSBB_POSTGRES_USER:-osbb}"

: "${OSBB_COGNITO_USER_POOL_ID:?Set OSBB_COGNITO_USER_POOL_ID in the environment file}"
: "${OSBB_COGNITO_CLIENT_ID:?Set OSBB_COGNITO_CLIENT_ID in the environment file}"

"${compose[@]}" up -d --wait --no-deps postgres

seed_database() (
  local seed="osbb_seed_$BASHPID"
  "${compose[@]}" exec -T postgres createdb -U "$database_user" -- "$seed"
  trap '"${compose[@]}" exec -T postgres dropdb --if-exists -U "$database_user" -- "$seed"' EXIT
  "${compose[@]}" exec -T postgres pg_dump -U "$database_user" -d "$import_database" --format=custom \
    | "${compose[@]}" exec -T postgres pg_restore -U "$database_user" --exit-on-error --no-owner --no-acl -d "$seed"
  "${compose[@]}" exec -T postgres psql -U "$database_user" -d postgres -v ON_ERROR_STOP=1 \
    -v seed="$seed" -v target="$web_database" <<'SQL'
ALTER DATABASE :"seed" RENAME TO :"target";
SQL
  trap - EXIT
)

(
  flock 9
  exists="$("${compose[@]}" exec -T postgres psql -U "$database_user" -d postgres -At -v ON_ERROR_STOP=1 \
    -v target="$web_database" <<'SQL'
SELECT 1 FROM pg_database WHERE datname = :'target';
SQL
)"
  if [[ "$exists" != 1 ]]; then seed_database; fi
) 9>"${XDG_RUNTIME_DIR:-/tmp}/osbb-web-api-$UID.lock"
exec "${compose[@]}" up -d --build frontend
