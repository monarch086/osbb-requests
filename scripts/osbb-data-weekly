#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$project_root/scripts/osbb-data-env.sh"
umask 077
lock_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/osbb-requests}"
mkdir -p -- "$lock_dir"
exec 9>"$lock_dir/osbb-data-weekly.lock"
if ! flock -n 9; then
  printf '%s\n' 'Попередній запланований імпорт ще виконується.' >&2
  exit 1
fi
cd "$project_root"
export OSBB_IMPORTER_UID="$(id -u)" OSBB_IMPORTER_GID="$(id -g)"
"${compose[@]}" up -d --wait --no-deps postgres
"${compose[@]}" up --build --no-deps --exit-code-from importer importer
./scripts/osbb-data backup
