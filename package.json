{
  "name": "osbb-requests",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot and administration API for OSBB maintenance requests",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "dotnet build OsbbRequests.sln --configuration Release",
    "check": "dotnet format OsbbRequests.sln --verify-no-changes --no-restore",
    "package:dotnet": "bash scripts/package-dotnet.sh",
    "package": "serverless package",
    "deploy": "serverless deploy",
    "remove": "serverless remove"
  },
  "devDependencies": {
    "serverless": "4.44.0"
  }
}
