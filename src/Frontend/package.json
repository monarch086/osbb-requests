{
  "name": "osbb-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4201",
    "build": "ng build",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:ts": "eslint \"src/**/*.{ts,html}\" --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:styles -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "aws-amplify": "^6.22.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
