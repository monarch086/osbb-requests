  <ItemGroup>
    <ProjectReference Include="../OsbbRequests.Shared/OsbbRequests.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.108" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
