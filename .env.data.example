OSBB_POSTGRES_PASSWORD=replace-with-the-postgres-password
OSBB_POSTGRES_USER=osbb
OSBB_POSTGRES_PORT=5433
OSBB_IMPORT_DATABASE=osbb-import
OSBB_DATABASE=osbb_dev

OSBB_IMPORT_HOST_CONNECTION_STRING="Host=127.0.0.1;Port=${OSBB_POSTGRES_PORT};Database=${OSBB_IMPORT_DATABASE};Username=${OSBB_POSTGRES_USER};Password=${OSBB_POSTGRES_PASSWORD};GSS Encryption Mode=Disable"
OSBB_IMPORT_DOCKER_CONNECTION_STRING="Host=postgres;Port=5432;Database=${OSBB_IMPORT_DATABASE};Username=${OSBB_POSTGRES_USER};Password=${OSBB_POSTGRES_PASSWORD};GSS Encryption Mode=Disable"
OSBB_CONNECTION_STRING="Host=postgres;Port=5432;Database=${OSBB_DATABASE};Username=${OSBB_POSTGRES_USER};Password=${OSBB_POSTGRES_PASSWORD};GSS Encryption Mode=Disable"

# Local Telegram listener (Compose profile command-listener)
OSBB_LISTENER_BOT_TOKEN_PARAMETER=
OSBB_LISTENER_BOT_USERNAME=
OSBB_LISTENER_COMPLEX_ID=
OSBB_LISTENER_COMMAND_DATA_TABLE=
OSBB_LISTENER_RESIDENTS_TABLE=
OSBB_LISTENER_AWS_PROFILE=default
OSBB_LISTENER_AWS_REGION=eu-central-1
